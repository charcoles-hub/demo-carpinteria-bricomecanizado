---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Bricomecanizado 2011 S.A.L.',
  description:
    'Corte, canteado, mecanizado CNC y prensado de tablero para profesionales del sector, en el polígono La Font Santa de Sant Joan Despí.',
  telephone: '+34933730460',
  email: 'bricomecanizado2011@gmail.com',
  url: 'http://bricomecanizado.es/esp/',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Av. de la Generalitat, 49',
    postalCode: '08970',
    addressLocality: 'Sant Joan Despí',
    addressRegion: 'Barcelona',
    addressCountry: 'ES',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 41.3692744, longitude: 2.0645162 },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '08:15', closes: '13:30' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '15:00', closes: '18:00' },
  ],
  sameAs: ['https://www.facebook.com/Bricomecanizado-2011-SAL-1601670086736685/'],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_ES" />

    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="theme-color" content="#1a1f1c" />

    <link rel="preload" href={`${base}fonts/archivo-variable.woff2`} as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="pb-20 md:pb-0">
    <p class="bg-tinta px-4 py-2 text-center text-[0.8125rem] leading-snug text-fondo">
      Propuesta de diseño para Bricomecanizado 2011 S.A.L. · preparada por
      <a href="https://sergiogarciaweb.com" class="underline hover:text-senal">Sergio García</a>
    </p>
    <slot />
  </body>
</html>
