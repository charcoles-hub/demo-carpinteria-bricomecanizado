---
import { Image, Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

import logo from '../assets/fotos/logo-bricomecanizado.png';
import rotulo from '../assets/fotos/rotulo-nombre.jpg';
import seccionadora from '../assets/fotos/seccionadora.jpg';
import cnc from '../assets/fotos/cnc.jpg';
import puertaEspecial from '../assets/fotos/puerta-especial.jpg';
import rejillaCuadrada from '../assets/fotos/rejilla-cuadrada.jpg';
import circulos from '../assets/fotos/circulos.jpg';
import puertaCombinada from '../assets/fotos/puerta-combinada.jpg';
import trapecio from '../assets/fotos/trapecio.jpg';
import multiplesFormas from '../assets/fotos/multiples-formas.jpg';
import rejillaPuerta from '../assets/fotos/rejilla-puerta.jpg';
import uneroCajon from '../assets/fotos/unero-cajon.jpg';
import folding from '../assets/fotos/folding.jpg';
import tallerSeccionadora from '../assets/fotos/taller-seccionadora.jpg';
import escuadradora from '../assets/fotos/escuadradora.jpg';
import tallerMueble from '../assets/fotos/taller-mueble.jpg';
import rejillas from '../assets/fotos/rejillas.jpg';
import unero from '../assets/fotos/unero.jpg';

const telefono = '93 373 04 60';
const telHref = 'tel:+34933730460';
const email = 'bricomecanizado2011@gmail.com';
const mailHref = `mailto:${email}?subject=${encodeURIComponent('Petición de presupuesto')}`;
const mapsHref =
  'https://www.google.com/maps/place/Bricomecanizado+2011+S.A.L./@41.3692744,2.0645162,17z/data=!3m1!4b1!4m6!3m5!1s0x12a49bd8e4278523:0x592176ac3ce3907f!8m2!3d41.3692744!4d2.0645162!16s%2Fg%2F1hc8cp5jj';
const facebookHref = 'https://www.facebook.com/Bricomecanizado-2011-SAL-1601670086736685/';

const servicios = [
  {
    nombre: 'Corte',
    texto: 'Corte de todo tipo de paneles, incluido el estratificado de alta presión (HPL).',
    foto: seccionadora,
    alt: 'Seccionadora de paneles en el taller, con un tablero sobre la mesa',
  },
  {
    nombre: 'Canteado',
    texto: 'Cantos de chapa natural, PVC o similares, estratificados y listones de madera. En diferentes anchos y gruesos.',
  },
  {
    nombre: 'Mecanizado CNC',
    texto: 'Mecanizados de todo tipo en paneles, con amplia experiencia interpretando archivos CAD-CAM.',
    foto: cnc,
    alt: 'Centro de mecanizado CNC del taller con su pantalla de control',
  },
  {
    nombre: 'Prensado',
    texto: 'Prensado de paneles con platos fríos o calientes de HPL.',
  },
  {
    nombre: 'Puertas fuera de medida',
    texto: 'Fabricación de puertas en medidas fuera de estándar.',
    foto: puertaEspecial,
    alt: 'Puerta de tablero de dimensiones especiales con travesaños horizontales',
  },
];

const piezas = [
  { foto: rejillaCuadrada, pie: 'Rejilla cuadrada', alt: 'Rejilla de cuadrícula en MDF delante de la seccionadora', clase: 'col-span-2 md:col-span-4 md:row-span-2' },
  { foto: circulos, pie: 'Círculos con forma', alt: 'Pieza circular de tablero con tres huecos curvos', clase: 'md:col-span-2' },
  { foto: puertaCombinada, pie: 'Puertas combinadas a medida', alt: 'Puerta de MDF con tres cristaleras arriba y plafones abajo', clase: 'md:col-span-2 md:row-span-2' },
  { foto: trapecio, pie: 'Trapecio de soporte', alt: 'Pieza de soporte en forma de trapecio calada en tablero', clase: 'md:col-span-2' },
  { foto: multiplesFormas, pie: 'Múltiples formas', alt: 'Tres aros de tablero entrelazados sobre una mesa', clase: 'md:col-span-2' },
  { foto: rejillaPuerta, pie: 'Rejilla a medida', alt: 'Puerta con dos paneles de rejilla calada', clase: 'md:col-span-2 md:row-span-2' },
  { foto: uneroCajon, pie: 'Uñero a medida', alt: 'Cajón lacado en blanco con uñero mecanizado en el frente', clase: 'md:col-span-2' },
  { foto: rejillas, pie: 'Rejillas', alt: 'Panel de MDF con lamas horizontales caladas', clase: 'md:col-span-2' },
  { foto: folding, pie: 'Detalle de folding', alt: 'Paneles con ranuras de plegado y una pieza con hueco circular', clase: 'col-span-2 md:col-span-4' },
  { foto: unero, pie: 'Uñeros', alt: 'Tablero con el perfil de un uñero mecanizado en el canto', clase: 'md:col-span-2' },
];

const materiales = [
  { nombre: 'Aglomerados' },
  { nombre: 'MDF', detalle: 'De Finsa, Medyland, Tafibra y otros.' },
  { nombre: 'Melaminas', detalle: 'De Egger, Finsa, Kronospan y Losan.' },
  { nombre: 'Laminados y compactos', detalle: 'De diferentes fabricantes.' },
];
---

<Layout
  title="Corte, canteado y mecanizado de tablero en Sant Joan Despí | Bricomecanizado 2011"
  description="Taller de corte, canteado, mecanizado CNC y prensado de tablero para profesionales en el polígono La Font Santa. Llama al 93 373 04 60 o pide presupuesto por email."
>
  <header class="sticky top-0 z-30 border-b border-linea bg-fondo/95 backdrop-blur-sm">
    <div class="mx-auto flex max-w-[1240px] items-center justify-between gap-4 px-4 py-3 md:px-8">
      <a href="#inicio" class="shrink-0 py-2.5" aria-label="Bricomecanizado 2011, ir al inicio">
        <Image src={logo} alt="Bricomecanizado" width={186} height={32} class="h-[26px] w-auto md:h-8" loading="eager" />
      </a>
      <nav aria-label="Principal" class="hidden lg:block">
        <ul class="flex gap-7 text-[0.9375rem] font-medium">
          <li><a href="#servicios" class="no-underline hover:underline">Qué hacemos</a></li>
          <li><a href="#piezas" class="no-underline hover:underline">Trabajos</a></li>
          <li><a href="#materiales" class="no-underline hover:underline">Materiales</a></li>
          <li><a href="#empresa" class="no-underline hover:underline">La empresa</a></li>
          <li><a href="#contacto" class="no-underline hover:underline">Dónde estamos</a></li>
        </ul>
      </nav>
      <a href={telHref} class="boton boton-principal min-h-11 px-4 py-2 text-[0.9375rem]" data-tabular>
        <span class="sm:hidden">Llamar</span>
        <span class="hidden sm:inline">Llamar al {telefono}</span>
      </a>
    </div>
  </header>

  <main id="inicio">
    <section aria-labelledby="titulo-portada" class="pt-8 md:pt-12">
      <div class="mx-auto max-w-[1240px] px-4 md:px-8">
        <h1 id="titulo-portada" class="titular md:max-w-[24ch]">
          Tablero cortado, canteado y mecanizado a medida
        </h1>
        <div class="mt-6 grid gap-6 md:mt-8 md:grid-cols-12 md:items-end">
          <p class="max-w-[58ch] text-lg text-texto-suave md:col-span-7 md:text-xl">
            Taller para profesionales en el polígono La Font Santa de Sant Joan Despí. Estudiamos,
            presupuestamos y ejecutamos tu proyecto en cualquier tipo de panel: aglomerado, melamina,
            MDF, HPL, fenólico…
          </p>
          <div class="flex flex-wrap gap-3 md:col-span-5 md:justify-end">
            <a href={telHref} class="boton boton-principal" data-tabular>Llamar al {telefono}</a>
            <a href={mailHref} class="boton boton-secundario">Pedir presupuesto por email</a>
          </div>
        </div>
        <p class="mt-3 text-[0.9375rem]">
          <a href={mapsHref} class="inline-block py-3 font-semibold underline" data-tabular>4,9 de valoración en Google (20 reseñas)</a>
        </p>
      </div>

      <figure class="mt-8 md:mt-12">
        <div class="mx-auto max-w-[1240px] px-4 md:px-8">
          <div class="cota cota-animada" aria-hidden="true"></div>
        </div>
        <Picture
          src={rotulo}
          formats={['avif', 'webp']}
          widths={[640, 960, 1440, 2000]}
          sizes="100vw"
          alt="Letras «BricoMecanitzat» recortadas en un tablero de MDF, sobre la mesa de mecanizado del taller"
          class="mt-3 aspect-[16/9] w-full object-cover object-[50%_45%] md:aspect-[21/8]"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption class="mx-auto max-w-[1240px] px-4 pt-3 text-sm text-texto-suave md:px-8">
          Nuestro nombre, recortado en tablero en el taller.
        </figcaption>
      </figure>
    </section>

    <section id="servicios" aria-labelledby="titulo-servicios" class="py-16 md:py-28">
      <div class="mx-auto max-w-[1240px] px-4 md:px-8">
        <h2 id="titulo-servicios" class="text-[clamp(1.6rem,1.2rem+1.6vw,2.6rem)]">Qué hacemos</h2>

        <ul class="mt-10 border-t border-tinta md:mt-14">
          {servicios.map((s) => (
            <li class="grid gap-4 border-b border-linea py-7 md:grid-cols-12 md:gap-8 md:py-9">
              <h3 class="text-[1.5rem] md:col-span-4 md:text-[1.875rem]">{s.nombre}</h3>
              <p class="max-w-[46ch] md:col-span-5 md:pt-1 md:text-lg">{s.texto}</p>
              {s.foto && (
                <Image
                  src={s.foto}
                  alt={s.alt}
                  widths={[400, 640, 800]}
                  sizes="(min-width: 768px) 25vw, 100vw"
                  class="aspect-[4/3] w-full object-cover md:col-span-3"
                  loading="lazy"
                />
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section aria-labelledby="titulo-sectores" class="bg-superficie py-16 md:py-24">
      <div class="mx-auto grid max-w-[1240px] gap-10 px-4 md:grid-cols-12 md:items-center md:gap-12 md:px-8">
        <div class="md:col-span-7">
        <h2 id="titulo-sectores" class="text-[clamp(1.6rem,1.2rem+1.6vw,2.6rem)]">Para los profesionales del sector</h2>
        <p class="mt-6 max-w-[30ch] text-[clamp(1.375rem,1rem+1.6vw,2.25rem)] font-medium leading-[1.25] md:mt-8 md:max-w-[34ch]" style="font-stretch: 108%">
          Mobiliario de hogar, hostelería, cocina, expositores, cabinas sanitarias, piezas para la
          industria y mecanizados especiales para decorados publicitarios.
        </p>
        <div class="cota cota-fina mt-10 max-w-[34rem]" aria-hidden="true"></div>
        <p class="mt-4 max-w-[60ch] text-texto-suave">
          ¿Un trabajo complicado? Consúltanos. Siempre estamos abiertos a estudiar trabajos que
          requieren complejidad y en los que podemos aportar nuestra experiencia.
        </p>
        </div>
        <figure class="md:col-span-5">
          <Image
            src={tallerMueble}
            alt="Estructura de mueble en MDF montada en el taller, junto a la maquinaria"
            widths={[480, 800, 1100]}
            sizes="(min-width: 768px) 40vw, 100vw"
            class="aspect-[4/3] w-full object-cover"
            loading="lazy"
          />
          <figcaption class="pt-3 text-sm text-texto-suave">Un mueble en MDF, en el taller.</figcaption>
        </figure>
      </div>
    </section>

    <section id="piezas" aria-labelledby="titulo-piezas" class="py-16 md:py-28">
      <div class="mx-auto max-w-[1240px] px-4 md:px-8">
        <h2 id="titulo-piezas" class="text-[clamp(1.6rem,1.2rem+1.6vw,2.6rem)]">Piezas que han salido del taller</h2>
        <ul class="mt-10 grid auto-rows-[9.5rem] grid-flow-dense grid-cols-2 gap-3 md:mt-14 md:auto-rows-[11rem] md:grid-cols-8 md:gap-4">
          {piezas.map((p) => (
            <li class:list={['relative overflow-hidden bg-superficie', p.clase]}>
              <figure class="h-full">
                <Image
                  src={p.foto}
                  alt={p.alt}
                  widths={[400, 700, 1000]}
                  sizes="(min-width: 768px) 40vw, 50vw"
                  class="h-full w-full object-cover"
                  loading="lazy"
                />
                <figcaption class="absolute bottom-0 left-0 bg-tinta/85 px-2.5 py-1 text-[0.8125rem] font-medium text-fondo">
                  {p.pie}
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="materiales" aria-labelledby="titulo-materiales" class="border-t border-linea py-16 md:py-28">
      <div class="mx-auto grid max-w-[1240px] gap-10 px-4 md:grid-cols-12 md:gap-12 md:px-8">
        <div class="md:col-span-7">
          <h2 id="titulo-materiales" class="text-[clamp(1.6rem,1.2rem+1.6vw,2.6rem)]">Materiales con los que trabajamos</h2>
          <dl class="mt-8 border-t border-tinta">
            {materiales.map((m) => (
              <div class="grid gap-1 border-b border-linea py-4 sm:grid-cols-[13rem_1fr] sm:gap-6">
                <dt class="font-bold" style="font-stretch: 110%">{m.nombre}</dt>
                {m.detalle && <dd class="text-texto-suave">{m.detalle}</dd>}
              </div>
            ))}
          </dl>
          <h3 class="mt-12 text-[1.375rem]">Cómo trabajamos</h3>
          <p class="mt-3 max-w-[60ch]">
            Tenemos el conocimiento y la tecnología para interpretar y optimizar cada trabajo hasta el
            punto de ejecución que nos pidas, con el trato directo que nos ha caracterizado siempre.
          </p>
        </div>
        <figure class="md:col-span-5 md:pt-16">
          <Image
            src={tallerSeccionadora}
            alt="Nave del taller con la seccionadora y sus mesas de apoyo"
            widths={[480, 800, 1100]}
            sizes="(min-width: 768px) 40vw, 100vw"
            class="aspect-[4/5] w-full object-cover"
            loading="lazy"
          />
          <figcaption class="pt-3 text-sm text-texto-suave">La zona de corte del taller.</figcaption>
        </figure>
      </div>
    </section>

    <section id="empresa" aria-labelledby="titulo-empresa" class="bg-superficie">
      <div class="grid md:grid-cols-2">
        <Image
          src={escuadradora}
          alt="Escuadradora del taller con el carro y la guía de corte"
          widths={[480, 800, 1200]}
          sizes="(min-width: 768px) 50vw, 100vw"
          class="aspect-[4/3] h-full w-full object-cover"
          loading="lazy"
        />
        <div class="max-w-[620px] px-4 py-12 md:px-12 md:py-24 lg:px-16">
          <h2 id="titulo-empresa" class="text-[clamp(1.6rem,1.2rem+1.6vw,2.6rem)]">Una empresa de 2011 con gente del sector desde 1980</h2>
          <p class="mt-6 max-w-[52ch]">
            Bricomecanizado nació en 2011, pero las personas que la forman trabajan en el sector desde
            1980, en una empresa mayorista de madera de larga trayectoria.
          </p>
          <p class="mt-4 max-w-[52ch]">
            Hoy nos dirigimos a los profesionales del sector: estudiamos, presupuestamos y ejecutamos
            cualquier proyecto con cualquier tipo de panel.
          </p>
        </div>
      </div>
    </section>

    <section id="contacto" aria-labelledby="titulo-contacto" class="sobre-suelo bg-suelo py-16 text-sobre-suelo md:py-28">
      <div class="mx-auto max-w-[1240px] px-4 md:px-8">
        <h2 id="titulo-contacto" class="titular max-w-[14ch]">Pásate por el taller o llámanos</h2>
        <div class="mt-10 grid gap-10 md:mt-14 md:grid-cols-12 md:gap-8">
          <div class="md:col-span-5">
            <h3 class="text-[1.25rem]">Dónde estamos</h3>
            <address class="mt-3 not-italic">
              Polígono Industrial La Font Santa<br />
              Av. de la Generalitat, 49<br />
              08970 Sant Joan Despí (Barcelona)
            </address>
            <p class="mt-3 max-w-[40ch] text-sobre-suelo-suave">
              Cerca de la AP-2 (detrás de TV3) y de las Rondas de Barcelona.
            </p>
            <a href={mapsHref} class="mt-2 inline-block py-3 font-semibold text-sobre-suelo underline">Cómo llegar en Google Maps</a>
          </div>
          <div class="md:col-span-3">
            <h3 class="text-[1.25rem]">Horario</h3>
            <dl class="mt-3" data-tabular>
              <dt class="text-sobre-suelo-suave">Lunes a viernes</dt>
              <dd>8:15 a 13:30 y 15:00 a 18:00</dd>
              <dt class="mt-3 text-sobre-suelo-suave">Sábado y domingo</dt>
              <dd>Cerrado</dd>
            </dl>
          </div>
          <div class="md:col-span-4">
            <h3 class="text-[1.25rem]">Teléfono y email</h3>
            <p class="mt-3 text-[1.5rem] font-bold" style="font-stretch: 112%" data-tabular>
              <a href={telHref} class="inline-block py-1.5 text-sobre-suelo no-underline hover:underline">{telefono}</a>
            </p>
            <p class="break-all">
              <a href={mailHref} class="inline-block py-3 text-sobre-suelo underline">{email}</a>
            </p>
            <p class="mt-3 text-sobre-suelo-suave">Te respondemos en 24 h, de lunes a viernes.</p>
          </div>
        </div>
        <div class="mt-12 flex flex-wrap gap-3">
          <a href={telHref} class="boton boton-principal" data-tabular>Llamar al {telefono}</a>
          <a href={mailHref} class="boton border-2 border-sobre-suelo text-sobre-suelo hover:bg-sobre-suelo hover:text-suelo">Pedir presupuesto por email</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-tinta py-12 text-[0.9375rem] text-fondo">
    <div class="mx-auto grid max-w-[1240px] gap-8 px-4 md:grid-cols-3 md:px-8">
      <div>
        <p class="font-bold" style="font-stretch: 112%">Bricomecanizado 2011, S.A.L.</p>
        <p class="mt-2 text-fondo/75">Corte, canteado, mecanizado y prensado de tablero.</p>
      </div>
      <address class="not-italic text-fondo/75">
        Av. de la Generalitat, 49<br />08970 Sant Joan Despí (Barcelona)
      </address>
      <div class="flex flex-col items-start">
        <a href={telHref} class="py-2.5 text-fondo underline" data-tabular>{telefono}</a>
        <a href={mailHref} class="break-all py-2.5 text-fondo underline">{email}</a>
        <a href={facebookHref} class="py-2.5 text-fondo underline">Facebook</a>
      </div>
    </div>
    <p class="mx-auto mt-10 max-w-[1240px] px-4 text-[0.8125rem] text-fondo/65 md:px-8">
      Propuesta de diseño preparada por <a href="https://sergiogarciaweb.com" class="text-fondo/80 underline">Sergio García</a>.
    </p>
  </footer>

  <nav aria-label="Contacto rápido" class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2 border-t border-linea bg-fondo px-3 pt-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] md:hidden">
    <a href={telHref} class="boton boton-principal">Llamar</a>
    <a href={mailHref} class="boton boton-secundario">Presupuesto</a>
  </nav>
</Layout>
